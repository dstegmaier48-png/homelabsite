      "x": 978.3967012677872,
      "y": 1095.9999123513699,
      "width": 341.39744567871094,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "as",
      "roundness": null,
      "seed": 1297402573,
      "version": 432,
      "versionNonce": 1628452387,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1786970501349,
      "link": null,
