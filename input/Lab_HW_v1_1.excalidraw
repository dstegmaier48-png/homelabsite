    {
      "id": "Z5kwp9c95F34rdvEZtOZN",
      "type": "text",
      "x": -127.03799874441984,
      "y": 366.6666603982449,
      "width": 733.599853515625,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a6",
      "roundness": null,
      "seed": 1654299373,
      "version": 3,
      "versionNonce": 601959267,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Vor fünf Jahren haben wir uns noch intensiv mit Scrum\nbeschäftigt.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vor fünf Jahren haben wir uns noch intensiv mit Scrum beschäftigt.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "itabhQLUNAsk7pKIzBfBE",
      "type": "text",
      "x": -99.58392769949796,
      "y": 491.66666039824486,
      "width": 678.6917114257812,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a7",
      "roundness": null,
      "seed": 505583203,
      "version": 3,
      "versionNonce": 1722019917,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Wie organisieren wir unsere Teams? Wie werden wir\nschneller, beweglicher, agiler?",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wie organisieren wir unsere Teams? Wie werden wir schneller, beweglicher, agiler?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "1mUJya8xmZ-c1fl6vThFn",
      "type": "text",
      "x": 75.4300035749161,
      "y": 634.1666603982449,
      "width": 328.6638488769531,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 1002616141,
      "version": 3,
      "versionNonce": 973850371,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Heute reden wir über KI.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Heute reden wir über KI.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Vgpd-aoGqWzqqjZrR5331",
      "type": "text",
      "x": -160.1759076799667,
      "y": 689.1666603982449,
      "width": 799.8756713867188,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 1592250883,
      "version": 3,
      "versionNonce": 314203821,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Und nicht nur darüber, welches Tool wir einsetzen. Sondern\ndarüber, was KI für unsere Arbeit bedeutet – und ganz\nkonkret für uns als Digital-Architektur-Abteilung.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Und nicht nur darüber, welches Tool wir einsetzen. Sondern darüber, was KI für unsere Arbeit bedeutet – und ganz konkret für uns als Digital-Architektur-Abteilung.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "KnH2X8eCpQUB7r_OIRkhN",
      "type": "text",
      "x": -92.51395089285734,
      "y": 884.1666603982449,
      "width": 664.5517578125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 1102611373,
      "version": 3,
      "versionNonce": 1403121315,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Ich glaube, darin liegt für uns eine große Chance.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ich glaube, darin liegt für uns eine große Chance.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SNfhpw3Zkzv5_kAGlx1uO",
      "type": "text",
      "x": -152.72794015066984,
      "y": 956.6666603982449,
      "width": 784.979736328125,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 918854051,
      "version": 3,
      "versionNonce": 582222093,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Denn eine Situation kennen wir alle: Wir laufen seit Jahren\neiner Welle von Arbeit hinterher.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Denn eine Situation kennen wir alle: Wir laufen seit Jahren einer Welle von Arbeit hinterher.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "46OmyHemx80gacDm5pMKX",
      "type": "text",
      "x": -142.52191598074796,
      "y": 1046.6666603982449,
      "width": 764.5676879882812,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 2024113677,
      "version": 3,
      "versionNonce": 324149827,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Es gibt mehr Themen, als wir bearbeiten können. Mehr\nSysteme, mehr Abhängigkeiten, mehr Entscheidungen. Wir\npriorisieren, wir strukturieren – und trotzdem kommt die\nnächste Welle.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Es gibt mehr Themen, als wir bearbeiten können. Mehr Systeme, mehr Abhängigkeiten, mehr Entscheidungen. Wir priorisieren, wir strukturieren – und trotzdem kommt die nächste Welle.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ldiGJO6-eOzvaWSl-g73b",
      "type": "text",
      "x": -109.95792061941984,
      "y": 1259.1666603982449,
      "width": 699.439697265625,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aD",
      "roundness": null,
      "seed": 1927769411,
      "version": 3,
      "versionNonce": 470439789,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Gleichzeitig verändert sich unsere Organisation. Wir\nwerden dezentraler. Mehr Verantwortung und mehr\nEntscheidungen wandern in die Teams.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Gleichzeitig verändert sich unsere Organisation. Wir werden dezentraler. Mehr Verantwortung und mehr Entscheidungen wandern in die Teams.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "3PuYM-I-TKDdyCXK3JrCC",
      "type": "text",
      "x": -79.49393136160734,
      "y": 1436.6666603982449,
      "width": 638.51171875,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 595803245,
      "version": 3,
      "versionNonce": 1106960867,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Und das bedeutet aus meiner Sicht nicht, dass\nArchitektur weniger wichtig wird.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Und das bedeutet aus meiner Sicht nicht, dass Architektur weniger wichtig wird.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "vDR4mBIg-2bm7JqeiLOGq",
      "type": "text",
      "x": 150.49796622140047,
      "y": 1579.1666603982449,
      "width": 178.52792358398438,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aF",
      "roundness": null,
      "seed": 917425379,
      "version": 3,
      "versionNonce": 419881421,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Im Gegenteil.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Im Gegenteil.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4zLNwdJGNsVq_zuC2N7YQ",
      "type": "text",
      "x": -141.17789132254484,
      "y": 1634.1666603982449,
      "width": 761.879638671875,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aG",
      "roundness": null,
      "seed": 1780164301,
      "version": 3,
      "versionNonce": 145403267,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Je dezentraler Entscheidungen getroffen werden, desto\nwichtiger werden gute Leitplanken, Orientierung und eine\ngemeinsame architektonische Sprache.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Je dezentraler Entscheidungen getroffen werden, desto wichtiger werden gute Leitplanken, Orientierung und eine gemeinsame architektonische Sprache.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "yKNTVDdthzDK5EForL0X-",
      "type": "text",
      "x": -100.40994698660734,
      "y": 1829.1666603982449,
      "width": 680.34375,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aH",
      "roundness": null,
      "seed": 900282499,
      "version": 3,
      "versionNonce": 784539693,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Der Bedarf an Architektur wird also eher steigen.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Der Bedarf an Architektur wird also eher steigen.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1XwGTEZIGTNQkaV3naSL4",
      "type": "text",
      "x": -157.47391183035734,
      "y": 1884.1666603982449,
      "width": 794.4716796875,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aI",
      "roundness": null,
      "seed": 1057408301,
      "version": 3,
      "versionNonce": 1788871971,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Und wenn wir genauso weiterarbeiten wie bisher, ist relativ\nklar, was passiert: Die Welle wird größer – aber wir nicht\nautomatisch schneller.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Und wenn wir genauso weiterarbeiten wie bisher, ist relativ klar, was passiert: Die Welle wird größer – aber wir nicht automatisch schneller.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "z_m7HwCuI5W9PdZxsmBhc",
      "type": "text",
      "x": 34.676005772181725,
      "y": 2079.166660398245,
      "width": 410.1718444824219,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 764751907,
      "version": 3,
      "versionNonce": 321426061,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Genau hier kommt KI ins Spiel.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Genau hier kommt KI ins Spiel.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "y3ljZbTSlXsH-xGq1zxhZ",
      "type": "text",
      "x": -138.22391183035734,
      "y": 2169.166660398245,
      "width": 755.9716796875,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aK",
      "roundness": null,
      "seed": 95393677,
      "version": 3,
      "versionNonce": 2135517379,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Nicht als Wundermittel. Und auch nicht als Selbstzweck.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nicht als Wundermittel. Und auch nicht als Selbstzweck.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "489lD6D1ZdxIDGV09QrY3",
      "type": "text",
      "x": 118.33998434884188,
      "y": 2259.166660398245,
      "width": 242.84388732910156,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aL",
      "roundness": null,
      "seed": 543241155,
      "version": 3,
      "versionNonce": 49330413,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Sondern als Hebel.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sondern als Hebel.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "_R8iyMJgabatfCjpj-tHQ",
      "type": "text",
      "x": -147.23993355887296,
      "y": 2331.666660398245,
      "width": 774.0037231445312,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aM",
      "roundness": null,
      "seed": 2018450925,
      "version": 3,
      "versionNonce": 1816483939,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "KI kann uns helfen, effizienter zu arbeiten und damit\nendlich die Chance zu bekommen, vor die Welle zu kommen.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "KI kann uns helfen, effizienter zu arbeiten und damit endlich die Chance zu bekommen, vor die Welle zu kommen.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "WkZi1TkFGwzHnAtccaYdZ",
      "type": "text",
      "x": -130.34198434012296,
      "y": 2456.666660398245,
      "width": 740.2078247070312,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aN",
      "roundness": null,
      "seed": 1311490915,
      "version": 3,
      "versionNonce": 1738871629,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Und wir reden dabei nicht über eine ferne Zukunft. Wir\narbeiten bereits aktiv mit KI.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Und wir reden dabei nicht über eine ferne Zukunft. Wir arbeiten bereits aktiv mit KI.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "jHDFWyMsshg60xGzt5iPp",
      "type": "text",
      "x": -155.2059369768417,
      "y": 2546.666660398245,
      "width": 789.9357299804688,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aO",
      "roundness": null,
      "seed": 1307498573,
      "version": 3,
      "versionNonce": 526537731,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Wir sehen, wie sie uns helfen kann, Informationen schneller\nzusammenzuführen, Dokumentationen zu erstellen und zu\naktualisieren, Zusammenhänge zu analysieren oder\nArchitekturentscheidungen vorzubereiten.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wir sehen, wie sie uns helfen kann, Informationen schneller zusammenzuführen, Dokumentationen zu erstellen und zu aktualisieren, Zusammenhänge zu analysieren oder Architekturentscheidungen vorzubereiten.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "kCTydOViErUYh5wdoCot3",
      "type": "text",
      "x": 35.10999625069735,
      "y": 2794.166660398245,
      "width": 409.3038635253906,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aP",
      "roundness": null,
      "seed": 1866686211,
      "version": 3,
      "versionNonce": 1033839021,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Nicht, damit KI für uns denkt.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nicht, damit KI für uns denkt.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "qjG7LaXHRR_BFycJYnHj6",
      "type": "text",
      "x": -137.8459516252792,
      "y": 2866.666660398245,
      "width": 755.2157592773438,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aQ",
      "roundness": null,
      "seed": 543704749,
      "version": 3,
      "versionNonce": 1218370467,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Sondern damit wir mehr Zeit für das eigentliche Denken\nhaben.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sondern damit wir mehr Zeit für das eigentliche Denken haben.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "hImFwMqjE1nOJUCUBpzsr",
      "type": "text",
      "x": -50.12198311941984,
      "y": 3009.166660398245,
      "width": 579.767822265625,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aR",
      "roundness": null,
      "seed": 774276771,
      "version": 3,
      "versionNonce": 973628429,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Das ist für mich ein entscheidender Punkt.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Das ist für mich ein entscheidender Punkt.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "HugJ4d17NDMSSDRYbMgBI",
      "type": "text",
      "x": -143.2638898577011,
      "y": 3064.166660398245,
      "width": 766.0516357421875,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aS",
      "roundness": null,
      "seed": 308603149,
      "version": 3,
      "versionNonce": 338259779,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Unsere Aufgabe als Architekten besteht nicht darin,\nmöglichst viele Dokumente zu produzieren oder möglichst\nviele Informationen selbst zusammenzusuchen.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Unsere Aufgabe als Architekten besteht nicht darin, möglichst viele Dokumente zu produzieren oder möglichst viele Informationen selbst zusammenzusuchen.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "cKFZww4Bu318pKqRg2Ew7",
      "type": "text",
      "x": -133.60394723074796,
      "y": 3241.666660398245,
      "width": 746.7317504882812,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aT",
      "roundness": null,
      "seed": 1636022851,
      "version": 3,
      "versionNonce": 819616365,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Unsere Aufgabe ist es, Orientierung zu geben und gute\nEntscheidungen möglich zu machen.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Unsere Aufgabe ist es, Orientierung zu geben und gute Entscheidungen möglich zu machen.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "lBMS2Ts6kt0wCBWN04P3e",
      "type": "text",
      "x": -152.2939191545761,
      "y": 3366.666660398245,
      "width": 784.1116943359375,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aU",
      "roundness": null,
      "seed": 895369069,
      "version": 3,
      "versionNonce": 610307811,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Und gerade in einer dezentraleren Organisation können wir\nnicht bei jeder Entscheidung persönlich dabei sein.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Und gerade in einer dezentraleren Organisation können wir nicht bei jeder Entscheidung persönlich dabei sein.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "hkzCCPAo_bH8h6yPc_k7-",
      "type": "text",
      "x": -63.98196847098234,
      "y": 3509.166660398245,
      "width": 607.48779296875,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 104430051,
      "version": 3,
      "versionNonce": 987661517,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Wir müssen unser Wissen skalierbarer machen.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wir müssen unser Wissen skalierbarer machen.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "shly0RuYCN1jRXJepl9_N",
      "type": "text",
      "x": -157.93594796316984,
      "y": 3564.166660398245,
      "width": 795.395751953125,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aW",
      "roundness": null,
      "seed": 798869965,
      "version": 3,
      "versionNonce": 1272101507,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Prinzipien müssen einfach zugänglich sein. Leitplanken\nmüssen verständlich sein. Wissen muss dort verfügbar sein,\nwo eine Entscheidung getroffen wird.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Prinzipien müssen einfach zugänglich sein. Leitplanken müssen verständlich sein. Wissen muss dort verfügbar sein, wo eine Entscheidung getroffen wird.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "-M1vi8LTFu5un_bXcquY8",
      "type": "text",
      "x": -40.96594674246671,
      "y": 3759.166660398245,
      "width": 561.4557495117188,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aX",
      "roundness": null,
      "seed": 2035697027,
      "version": 3,
      "versionNonce": 464413485,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "KI kann dabei unsere Reichweite erhöhen.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "KI kann dabei unsere Reichweite erhöhen.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WgZAlQ3tcpDD6GZMeYhCr",
      "type": "text",
      "x": -154.40790230887296,
      "y": 3796.666660398245,
      "width": 788.3396606445312,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aY",
      "roundness": null,
      "seed": 574425133,
      "version": 3,
      "versionNonce": 121532963,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Sie ersetzt nicht die Erfahrung eines Architekten. Sie\nersetzt nicht unser Verständnis der Organisation. Und sie\nnimmt uns auch nicht die Verantwortung für\nEntscheidungen ab.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sie ersetzt nicht die Erfahrung eines Architekten. Sie ersetzt nicht unser Verständnis der Organisation. Und sie nimmt uns auch nicht die Verantwortung für Entscheidungen ab.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "dyU4LY3dgtbeZOgXtYRld",
      "type": "text",
      "x": 1.6920122419082873,
      "y": 4044.166660398245,
      "width": 476.13983154296875,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aZ",
      "roundness": null,
      "seed": 1914215715,
      "version": 3,
      "versionNonce": 1739814285,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Aber sie kann uns schneller machen.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aber sie kann uns schneller machen.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "XOgDLjq69iY-H2Vf66iw1",
      "type": "text",
      "x": -129.5999494280136,
      "y": 4116.666660398245,
      "width": 738.7237548828125,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aa",
      "roundness": null,
      "seed": 1327856269,
      "version": 3,
      "versionNonce": 932328899,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Und sie kann dafür sorgen, dass unsere Erfahrung und\nunser Wissen an viel mehr Stellen wirken als heute.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Und sie kann dafür sorgen, dass unsere Erfahrung und unser Wissen an viel mehr Stellen wirken als heute.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "uvpgUUEaNAvG_ecVRWQpz",
      "type": "text",
      "x": -23.325962611607338,
      "y": 4259.166660398245,
      "width": 526.17578125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ab",
      "roundness": null,
      "seed": 1005519043,
      "version": 3,
      "versionNonce": 1780956141,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Natürlich wird nicht alles funktionieren.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Natürlich wird nicht alles funktionieren.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "pq5R2KkKBKMjC8sCqeuOs",
      "type": "text",
      "x": -151.20193917410734,
      "y": 4279.166660398245,
      "width": 781.927734375,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ac",
      "roundness": null,
      "seed": 2131796205,
      "version": 3,
      "versionNonce": 468485475,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170701,
      "link": null,
      "locked": false,
      "text": "Wir werden Dinge ausprobieren, die uns wenig bringen. Und\nwir werden sicherlich auch erleben, dass eine KI mit\nbeeindruckender Selbstsicherheit etwas behauptet, von\ndem wir genauso selbstsicher sagen können: Das ist\nschlicht falsch.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wir werden Dinge ausprobieren, die uns wenig bringen. Und wir werden sicherlich auch erleben, dass eine KI mit beeindruckender Selbstsicherheit etwas behauptet, von dem wir genauso selbstsicher sagen können: Das ist schlicht falsch.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ZqEAnrwukvKlPHAp439x0",
      "type": "text",
      "x": -96.74194771902921,
      "y": 4561.666660398245,
      "width": 673.0077514648438,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ad",
      "roundness": null,
      "seed": 813166691,
      "version": 3,
      "versionNonce": 1259550285,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Deshalb müssen wir lernen, professionell mit KI zu\narbeiten.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deshalb müssen wir lernen, professionell mit KI zu arbeiten.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "kjRiNCs_djNSzpsUXso5d",
      "type": "text",
      "x": -137.0899701799667,
      "y": 4669.166660398245,
      "width": 753.7037963867188,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ae",
      "roundness": null,
      "seed": 663223117,
      "version": 3,
      "versionNonce": 194765059,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Nicht jedem Hype hinterherlaufen. Ergebnisse kritisch\nprüfen. Aber eben auch nicht warten, bis andere für uns\nherausgefunden haben, was möglich ist.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nicht jedem Hype hinterherlaufen. Ergebnisse kritisch prüfen. Aber eben auch nicht warten, bis andere für uns herausgefunden haben, was möglich ist.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "ovPiyEtdUcAX0yxauEbQx",
      "type": "text",
      "x": -56.65997750418546,
      "y": 4864.166660398245,
      "width": 592.8438110351562,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "af",
      "roundness": null,
      "seed": 1904339971,
      "version": 3,
      "versionNonce": 1968235693,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Ich wünsche mir deshalb von uns drei Dinge:",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Ich wünsche mir deshalb von uns drei Dinge:",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "CAYdkOvJRdLlWLjdBBS2Q",
      "type": "text",
      "x": -13.987980433872963,
      "y": 4954.166660398245,
      "width": 507.49981689453125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ag",
      "roundness": null,
      "seed": 1357187501,
      "version": 3,
      "versionNonce": 1881065635,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Neugier. Pragmatismus. Und Anspruch.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Neugier. Pragmatismus. Und Anspruch.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "OgZXBqHluZVLeq86zYMfB",
      "type": "text",
      "x": -155.8919416155136,
      "y": 5044.166660398245,
      "width": 791.3077392578125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ah",
      "roundness": null,
      "seed": 1661694883,
      "version": 3,
      "versionNonce": 1015662349,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Neugier, um auszuprobieren, wo KI uns wirklich helfen kann.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Neugier, um auszuprobieren, wo KI uns wirklich helfen kann.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "NG8A0p92XEDkIKcUYi7W2",
      "type": "text",
      "x": -147.6599164690292,
      "y": 5116.666660398245,
      "width": 774.8436889648438,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ai",
      "roundness": null,
      "seed": 1011960845,
      "version": 3,
      "versionNonce": 2133048387,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Pragmatismus, um das weiterzuverfolgen, was tatsächlich\nWirkung zeigt.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Pragmatismus, um das weiterzuverfolgen, was tatsächlich Wirkung zeigt.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "VJ7BhbxuETk6l_A2_MHi5",
      "type": "text",
      "x": -125.20392281668546,
      "y": 5224.166660398245,
      "width": 729.9317016601562,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aj",
      "roundness": null,
      "seed": 1698891587,
      "version": 3,
      "versionNonce": 1127701869,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Und Anspruch, weil schneller allein nicht reicht. Unsere\nEntscheidungen müssen weiterhin gut sein und unsere\nArchitektur muss Orientierung geben.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Und Anspruch, weil schneller allein nicht reicht. Unsere Entscheidungen müssen weiterhin gut sein und unsere Architektur muss Orientierung geben.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "0al1nGDac2siJfJ2E4NXq",
      "type": "text",
      "x": -152.86795479910734,
      "y": 5401.666660398245,
      "width": 785.259765625,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ak",
      "roundness": null,
      "seed": 1237729901,
      "version": 3,
      "versionNonce": 881408995,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Vor fünf Jahren haben wir viel über Scrum gesprochen, weil\nsich verändert hat, wie wir Software entwickeln.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Vor fünf Jahren haben wir viel über Scrum gesprochen, weil sich verändert hat, wie wir Software entwickeln.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "gju2iOPc9yXBXyr4ShDpr",
      "type": "text",
      "x": -59.72598702566984,
      "y": 5544.166660398245,
      "width": 598.975830078125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "al",
      "roundness": null,
      "seed": 1317480163,
      "version": 3,
      "versionNonce": 547563469,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Heute verändert KI erneut, wie wir arbeiten.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Heute verändert KI erneut, wie wir arbeiten.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "4rEpBI9hBHgmTgJ7FVCbC",
      "type": "text",
      "x": -145.0699506487167,
      "y": 5616.666660398245,
      "width": 769.6637573242188,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 504196301,
      "version": 3,
      "versionNonce": 207472515,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Für uns ist dabei die entscheidende Frage nicht mehr, ob\nwir KI einsetzen.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Für uns ist dabei die entscheidende Frage nicht mehr, ob wir KI einsetzen.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "cieRbENhwFAINTK9TtIOI",
      "type": "text",
      "x": -104.37195260184171,
      "y": 5741.666660398245,
      "width": 688.2677612304688,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "an",
      "roundness": null,
      "seed": 627462787,
      "version": 3,
      "versionNonce": 1189520941,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Sondern: Wie setzen wir sie so ein, dass sie unsere\nWirkung vervielfacht?",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sondern: Wie setzen wir sie so ein, dass sie unsere Wirkung vervielfacht?",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "6aGpGOGYVqoDBpHCCRky-",
      "type": "text",
      "x": -155.33194405691984,
      "y": 5866.666660398245,
      "width": 790.187744140625,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 146819885,
      "version": 3,
      "versionNonce": 2095046435,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Denn der Bedarf an Architektur wird nicht kleiner. Er wird\ngrößer.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Denn der Bedarf an Architektur wird nicht kleiner. Er wird größer.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "kB92DsVZwT6fUNNIqosKz",
      "type": "text",
      "x": -152.3638959612167,
      "y": 5956.666660398245,
      "width": 784.2516479492188,
      "height": 140,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ap",
      "roundness": null,
      "seed": 446630435,
      "version": 3,
      "versionNonce": 686512269,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Und genau deshalb sollten wir KI nutzen: um unser Wissen\nbesser verfügbar zu machen, Entscheidungen besser zu\nunterstützen und unsere eigene Arbeit effizienter zu\nmachen.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Und genau deshalb sollten wir KI nutzen: um unser Wissen besser verfügbar zu machen, Entscheidungen besser zu unterstützen und unsere eigene Arbeit effizienter zu machen.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "A0Qtp20ZN8bFlcppXEmEI",
      "type": "text",
      "x": -145.9239240373886,
      "y": 6186.666660398245,
      "width": 771.3717041015625,
      "height": 70,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aq",
      "roundness": null,
      "seed": 709385613,
      "version": 3,
      "versionNonce": 813564611,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Damit wir nicht mehr nur versuchen, mit der Welle Schritt\nzu halten.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Damit wir nicht mehr nur versuchen, mit der Welle Schritt zu halten.",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "2GKk94WXfBG6Bmp_ho_EH",
      "type": "text",
      "x": -79.78793770926359,
      "y": 6329.166660398245,
      "width": 639.0997314453125,
      "height": 35,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ar",
      "roundness": null,
      "seed": 1126157763,
      "version": 3,
      "versionNonce": 543866605,
      "isDeleted": true,
      "boundElements": null,
      "updated": 1786969170702,
      "link": null,
      "locked": false,
      "text": "Sondern damit wir endlich vor die Welle kommen.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Sondern damit wir endlich vor die Welle kommen.",
      "autoResize": true,
      "lineHeight": 1.25
    },
